PORTONE_API_KEY=
PORTONE_API_SECRET=

# 3. 카카오 간편인증 SDK
KAKAO_JS_KEY=37a9a46c109d93fa14589d3810a9c402

# 4. OpenRouter AI 자산관리 솔루션
OPENROUTER_API_KEY=your_openrouter_api_key_here
