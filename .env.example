# 1. 금융결제원 오픈뱅킹 표준 API
OPENBANKING_API_HOST=https://testapi.openbanking.or.kr
OPENBANKING_CLIENT_ID=test_client_id_kftc_9824
OPENBANKING_CLIENT_SECRET=test_client_secret_kftc_secret_key
OPENBANKING_REDIRECT_URI=http://localhost:5173/api/openbanking/callback

# 2. 포트원 통신사 본인인증
